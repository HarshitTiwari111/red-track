# ---- KAP Tracker configuration ----
# Mongo connection (database name must be kaptracker)
MONGO_URI=mongodb://127.0.0.1:27017/kaptracker

# Secret used to sign JWTs - CHANGE THIS
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port (fixed for this deployment)
PORT=3010

# Public base URL of the tracker (used in tracking links, macros, /track.js)
BASE_URL=http://localhost:3010

# Telegram alerts - leave empty to disable them entirely
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Node environment: development | production
NODE_ENV=development

# Number of reverse proxies in front of the app. Keep 0 while the port is
# directly reachable: any higher value makes the login rate limiter trust
# X-Forwarded-For, which a direct client can simply forge. Set it to 1 once
# nginx/Cloudflare fronts the app AND port 3010 is firewalled off.
TRUST_PROXY=0

# The CNAME value tracking domains are told to point at. Defaults to the host
# in BASE_URL, which is right for a single server. Override when the tracker
# sits behind a load balancer or a vanity hostname.
DNS_TARGET_CNAME=

# Resolvers used to verify tracking domains. Defaults to 1.1.1.1,8.8.8.8 rather
# than the system resolvers on purpose: verification asks what the public
# internet sees, and the local resolver may be a stub on 127.0.0.1, a
# split-horizon view, or a cache still serving the pre-change answer.
# Use DNS_RESOLVERS=system to fall back to /etc/resolv.conf.
DNS_RESOLVERS=

# Seed admin credentials (optional - random password is generated when omitted)
SEED_ADMIN_EMAIL=admin@kaptracker.local
SEED_ADMIN_PASSWORD=
